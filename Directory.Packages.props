<Project>

  <!-- Every package version is pinned here, once. Projects reference packages without a Version attribute.
       No floating versions: a floating HartsyInference reference is what the Swarm extension used, and it made
       builds depend on what was published that day. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Bit.Bheadless" Version="11.0.0-pre-23" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Exact pins: the brackets forbid any other version, so a pre-release is used only as it was tested (D7). -->
    <PackageVersion Include="HartsyInference.Engine" Version="[2.0.0-alpha.445]" />
    <PackageVersion Include="HartsyInference.Cuda" Version="[2.0.0-alpha.445]" />
    <!-- Pulled in by HartsyInference; pinned here at the versions it resolves to, so an update of the engine cannot move them silently. -->
    <PackageVersion Include="Google.Protobuf" Version="[3.30.2]" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="[2.0.0]" />
  </ItemGroup>

</Project>
