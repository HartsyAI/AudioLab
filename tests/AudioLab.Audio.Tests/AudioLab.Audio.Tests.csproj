<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AudioLab.Audio.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test classes and methods are public for the runner, not as an API, so they need no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AudioLab.Audio\AudioLab.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain HttpClient code that ships in the worker's runtime; it runs anywhere, so it is tested here. -->
    <Compile Include="..\..\src\AudioLab.Audio.Worker\HttpClipSource.cs" Link="Support\HttpClipSource.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
