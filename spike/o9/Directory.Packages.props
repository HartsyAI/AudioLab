    <PackageVersion Include="HartsyInference.Diffusion" Version="2.0.0-alpha.445" />
    <PackageVersion Include="HartsyInference.Audio" Version="2.0.0-alpha.445" />
    <PackageVersion Include="HartsyInference.Vision" Version="2.0.0-alpha.445" />
    <PackageVersion Include="HartsyInference.Video" Version="2.0.0-alpha.445" />
    <PackageVersion Include="HartsyInference.World" Version="2.0.0-alpha.445" />
    <PackageVersion Include="HartsyInference.ThreeD" Version="2.0.0-alpha.445" />
    <PackageVersion Include="HartsyInference.LLM" Version="2.0.0-alpha.445" />
