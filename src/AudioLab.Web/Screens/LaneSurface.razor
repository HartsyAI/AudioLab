<div id="lane-surface" class="surface" style="width: @Css.Px(Width); height: @Css.Px(Layout.Total)">
    <svg class="grid" width="@Css.Number(Width)" height="@Css.Number(Layout.Total)" aria-hidden="true">
        <path class="weak" d="@WeakPath"></path>
        <path class="strong" d="@StrongPath"></path>
    </svg>
    @for (int index = 0; index < Document.Tracks.Count; index++)
    {
        Track track = Document.Tracks[index];
        <div @key="track.Id" class="lane" data-selected="@(track.Id == SelectedTrack ? "true" : "false")"
             style="top: @Css.Px(Layout.Tops[index]); height: @Css.Px(Layout.ClipHeights[index])" @onclick="() => OnSelectTrack.InvokeAsync(track.Id)"
             @ondblclick="press => OnLaneDoubleClick.InvokeAsync((track.Id, press.OffsetX))">
            @foreach (AudioClip clip in track.Clips)
            {
                <Clip @key="clip.Id" Audio="clip" ColorToken="@Colors.Token(clip.Color ?? track.Color)" Left="@(Geometry.X(clip.Start) + 1)"
                      Width="@AudioWidth(clip)" Selected="@(clip.Id == SelectedClip)" Dimmed="@(clip.Muted || track.Muted)"
                      TabStop="@(clip.Id == TabStop)" PixelsPerSecond="Geometry.PixelsPerSecond"
                      OnSelect="OnSelectClip" OnKey="OnClipKey" OnPointerDown="OnClipPointerDown" />
            }
            @foreach (MidiClip clip in track.MidiClips)
            {
                <Clip @key="clip.Id" Midi="clip" ColorToken="@Colors.Token(clip.Color ?? track.Color)" Left="@(Geometry.X(clip.Start) + 1)"
                      Width="@MidiWidth(clip)" Selected="@(clip.Id == SelectedClip)" Dimmed="@(clip.Muted || track.Muted)"
                      TabStop="@(clip.Id == TabStop)" OnSelect="OnSelectClip" OnOpen="OnOpenClip" OnKey="OnClipKey"
                      OnPointerDown="OnClipPointerDown" />
            }
        </div>
        @if (track.View.AutomationVisible && Lanes is not null)
        {
            <AutomationLane Track="track" Lanes="Lanes" Plan="PlanOf(track)" Top="@Layout.AutomationTop(index)" Width="@Width"
                            ColorToken="@Colors.Token(track.Color)" Editable="CanEdit" Reason="@Reason"
                            OnPointerDown="press => OnAutomationPointDown.InvokeAsync((track.Id, press))"
                            OnDoubleClick="click => OnAutomationAdd.InvokeAsync((track.Id, click))"
                            OnKey="key => OnAutomationKey.InvokeAsync((track.Id, key))" />
        }
        else if (Lanes is not null && CanEdit)
        {
            <div class="show-automation" style="top: @Css.Px(Layout.Tops[index] + 4)">
                <Button Name="Show automation lane" OnClick="() => OnShowAutomation.InvokeAsync(track.Id)">Automation</Button>
            </div>
        }
    }
    <DragLayer Document="Document" PixelsPerSecond="Geometry.PixelsPerSecond" />
    <div class="playhead" style="left: 0"></div>
</div>
