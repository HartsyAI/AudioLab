<header class="top-bar">
    <div class="brand">
        <a class="mark" href="" aria-label="AudioLab: all projects"><Icon Name="IconName.Logo" Size="16" /></a>
        <div class="titles">
            <h1 class="name">@Document.Name</h1>
            <span class="sub">@Summary</span>
        </div>
    </div>
    <div class="history">
        <Button Variant="ButtonVariant.Icon" Name="Undo" Shortcut="@Shortcuts.Undo.Display" Disabled="@(!Actions.CanEdit)"
                DisabledReason="@Actions.Reason" OnClick="Actions.Undo"><Icon Name="IconName.Undo" Size="14" /></Button>
        <Button Variant="ButtonVariant.Icon" Name="Redo" Shortcut="@Shortcuts.Redo.Display" Disabled="@(!Actions.CanEdit)"
                DisabledReason="@Actions.Reason" OnClick="Actions.Redo"><Icon Name="IconName.Redo" Size="14" /></Button>
    </div>
    <Segmented Transport="true" Label="Transport" Items="TransportItems" Value="@(Playing ? "play" : null)" Wide="play"
               ValueChanged="ChooseAsync" />
    <TransportCounter Document="Document" />
    <div class="toggles">
        <Toggle Label="Loop" Name="Loop" On="Playback.Looping" Disabled="@(!Playback.Available)" Reason="@PlaybackReason"
                OnClick="ToggleLoop" />
        <Toggle Label="Click" Name="Click" On="Document.Metronome" Disabled="@(!Actions.CanEdit)" Reason="@Actions.Reason"
                OnClick="ToggleClickAsync" />
        <Toggle Label="Punch" Name="Punch" Disabled="true" Reason="Punching in arrives with recording, which needs the audio devices." />
        <Toggle Label="Follow" Name="Follow" Disabled="true" Reason="Following the playhead arrives with scrolling the timeline." />
    </div>
    <div class="spacer"></div>
    <Segmented Label="Tool" Items="ToolItems" Value="pointer" />
    <Button Name="Grid" Disabled="true" DisabledReason="Changing the grid arrives with the tempo and grid screens.">
        <span class="grid-label">Grid</span>
        <span>@GridText</span>
        <Icon Name="IconName.Chevron" Size="9" />
    </Button>
    <Presence Members="People" />
    <Button Variant="ButtonVariant.Primary" Name="Export" Disabled="true" DisabledReason="Export arrives with the audio engine.">Export</Button>
</header>
