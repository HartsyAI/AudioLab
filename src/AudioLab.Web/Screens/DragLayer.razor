@if (Drag is { Active: true } drag && Found(drag.Clip) is { } found)
{
    <div class="landing" aria-hidden="true"
         style="left: @Css.Px(drag.LandingLeft); top: @Css.Px(drag.LandingTop); width: @Css.Px(drag.Width); height: @Css.Px(drag.Height)"></div>
    <Clip Lifted="true" Audio="found.Audio" Midi="found.Midi" ColorToken="@Colors.Token(found.Color)" Left="drag.Left" Top="drag.Top"
          Width="drag.Width" Height="drag.Height" Selected="true" Waveform="@Waveform(found.Audio, drag.Width)" />
}
