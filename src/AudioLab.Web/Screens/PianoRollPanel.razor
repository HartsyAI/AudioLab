<div class="piano-roll" role="region" aria-label="Piano roll">
    @if (Open is { } open)
    {
        <div class="bar">
            <span class="title">@open.Clip.Name</span>
            <span class="meta">@NotesText(open.Clip) · @LengthText(open.Clip)</span>
            <span class="length">
                <Button Name="Shorten clip by a bar" Shortcut="@Shortcuts.MidiClipShorter.Display" Disabled="@(!Actions.CanEdit)"
                        DisabledReason="@Actions.Reason" OnClick="() => StepAsync(open.Clip, -1)">Shorter</Button>
                <Button Name="Lengthen clip by a bar" Shortcut="@Shortcuts.MidiClipLonger.Display" Disabled="@(!Actions.CanEdit)"
                        DisabledReason="@Actions.Reason" OnClick="() => StepAsync(open.Clip, 1)">Longer</Button>
            </span>
        </div>
        <EmptyState Heading="The note editor comes next"
                    Message="The notes are drawn in the clip in the arrangement; editing them here arrives in the next change." />
    }
    else
    {
        <EmptyState Heading="No MIDI clip selected" Message="@EmptyMessage">
            @if (Target is { } track)
            {
                <Button Variant="ButtonVariant.Primary" Name="Add MIDI clip" Shortcut="@Shortcuts.AddMidiClip.Display" Disabled="@(!Actions.CanEdit)"
                        DisabledReason="@Actions.Reason" OnClick="() => AddAsync(track)">Add MIDI clip</Button>
            }
            else if (!HasInstrument)
            {
                <Button Name="Add instrument track" Disabled="@(!Actions.CanEdit)" DisabledReason="@Actions.Reason"
                        OnClick="Actions.AddInstrumentTrack">Add instrument track</Button>
            }
        </EmptyState>
    }
</div>
