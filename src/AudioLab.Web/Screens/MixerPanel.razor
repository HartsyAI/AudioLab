<div class="mixer" id="@MixerId" role="region" aria-label="Mixer">
    @foreach (MixerLane lane in Lanes)
    {
        if (lane.Group is { } group)
        {
            <GroupStrip @key="group.Id" Group="group" Members="lane.Members" ColorToken="@Colors.Token(group.Color)" Palette="Colors.Values"
                        Actions="Actions" />
        }
        else if (lane.Track is { } track)
        {
            <ChannelStrip @key="track.Id" Name="@track.Name" ColorToken="@Colors.Token(track.Color)" Effects="Effects(track)" Pan="track.Pan"
                          Volume="track.Volume" Muted="track.Muted" Soloed="track.Soloed" Selected="@(track.Id == Selected)" Track="track.Id"
                          Editable="Actions.CanEdit" Reason="@Actions.Reason" OnMute="Actions.ToggleMute" OnSolo="Actions.ToggleSolo"
                          OnOpenEffects="OpenEffects" Silence="@SilenceOf(track)" />
        }
    }
    <ChannelStrip Name="Master" ColorToken="var(--text)" Effects="MasterEffects" Volume="Document.MasterVolume" Master="true"
                  MasterNote="The master limiter is a project setting; the master has no effect chain." Editable="Actions.CanEdit" Reason="@Actions.Reason"
                  OnVolume="Actions.Master.SetVolume" LimiterOn="Document.MasterLimiter" OnLimiter="Actions.Master.SetLimiter" />
    <SendsPanel Document="Document" Actions="Actions" Selected="SelectedTrack" />
</div>
