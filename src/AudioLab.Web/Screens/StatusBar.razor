<footer class="status-bar">
    <StatusItem Dot="Dot" Soft="true">@State</StatusItem>
    @if (Retry is not null)
    {
        <Button Name="Try again" OnClick="Retry">Try again</Button>
    }
    <StatusItem>@Counts</StatusItem>
    <span class="spacer"></span>
    <StatusItem>@RevisionText</StatusItem>
</footer>
