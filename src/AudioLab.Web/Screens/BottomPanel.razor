<div class="bottom-panel" data-tab="@Slug">
    <Tabs Names="Names" Label="Tools for the selection" Selected="@Panel.Active" SelectedChanged="Panel.Show">
        <TabContent Context="tab">
            @if (tab == BottomPanelState.Mixer)
            {
                <MixerPanel Document="Document" Selected="Selected" Actions="Actions" />
            }
            else if (tab == BottomPanelState.PianoRoll)
            {
                <PianoRollPanel Document="Document" Actions="Actions" />
            }
            else if (tab == BottomPanelState.Effects)
            {
                <EffectsPanel Document="Document" Selected="Selected" Actions="Actions" />
            }
            else if (tab == "Media")
            {
                <MediaPanel Document="Document" Actions="Actions" />
            }
            else if (tab == "Lyrics")
            {
                <LyricsPanel Document="Document" Actions="Actions" />
            }
            else
            {
                <EmptyState Heading="@tab" Message="@($"The {tab.ToLowerInvariant()} tab arrives in a later phase.")" />
            }
        </TabContent>
    </Tabs>
</div>
