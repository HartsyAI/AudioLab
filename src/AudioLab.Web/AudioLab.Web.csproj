<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>AudioLab.Web</RootNamespace>
    <!-- Native dialogs and the token reader call browser built-ins through [JSImport]; the generator needs unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- index.html names _framework/blazor.webassembly.js directly: the importmap placeholder of the template is an inline script. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <StaticWebAssetsFingerprintingEnabled>false</StaticWebAssetsFingerprintingEnabled>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <InternalsVisibleTo Include="AudioLab.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bit.Bheadless" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioLab.Core\AudioLab.Core.csproj" />
  </ItemGroup>

</Project>
