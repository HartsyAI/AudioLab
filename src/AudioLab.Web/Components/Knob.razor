<div class="knob" role="img" aria-label="@($"{Label} {Text}")">
    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10" class="disc"></circle>
        <circle cx="12" cy="12" r="9" class="rim"></circle>
        <line x1="12" y1="12" x2="12" y2="4.5" class="pointer" transform="@Transform"></line>
    </svg>
    <span class="value">@Text</span>
</div>
