<span class="tooltip-root">
    <BitBhTooltip>
        <BitBhTooltipTrigger As="button" type="@(Submit ? "submit" : "button")" aria-label="@Name" aria-disabled="@(Disabled ? "true" : null)"
                             @onclick="ClickAsync" @attributes="Attributes">@ChildContent</BitBhTooltipTrigger>
        <BitBhTooltipContent class="tooltip" Anchor="@(new BitBhAnchorOptions { To = "bottom", Gap = 6 })">
            <span class="tooltip-name">@Text</span>
            @if (Shortcut is not null && !Disabled)
            {
                <kbd class="tooltip-shortcut">@Shortcut</kbd>
            }
        </BitBhTooltipContent>
    </BitBhTooltip>
</span>
