<span class="tooltip-root">
    <BitBhTooltip>
        <BitBhTooltipTrigger As="button" type="@(Submit && !Disabled ? "submit" : "button")" aria-label="@Name" aria-disabled="@(Disabled ? "true" : null)"
                             @onclick="ClickAsync" @attributes="Attributes">@ChildContent</BitBhTooltipTrigger>
        <BitBhTooltipContent class="tooltip" Anchor="Anchor" Portal="false">
            <span class="tooltip-name">@(Text ?? Name)</span>
            @if (Shortcut is not null)
            {
                <kbd class="tooltip-shortcut">@Shortcut</kbd>
            }
        </BitBhTooltipContent>
    </BitBhTooltip>
</span>
