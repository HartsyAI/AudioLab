<div class="segmented" data-variant="@(Transport ? "transport" : "choice")" role="group" aria-label="@Label">
    @foreach (SegmentItem item in Items)
    {
        <Tooltip @key="item.Id" Text="@(item.Reason ?? item.Name)" Name="@item.Name" Shortcut="@item.Shortcut" Disabled="@(item.Reason is not null)"
                 OnClick="() => ChooseAsync(item)" class="segment" data-chosen="@(item.Id == Value ? "true" : "false")"
                 data-wide="@(item.Id == Wide ? "true" : "false")" aria-pressed="@(item.Id == Value ? "true" : "false")">
            @if (item.Icon is IconName icon)
            {
                <Icon Name="icon" Size="@(Transport ? 14 : 13)" />
            }
            else
            {
                @item.Label
            }
        </Tooltip>
    }
</div>
