<div class="menu-root" @onkeydown:stopPropagation="_open">
    <BitBhMenu OnOpenChange="OpenChangedAsync">
        <BitBhMenuButton id="@ButtonId" class="menu-button" data-variant="@(Icon ? "icon" : "default")" aria-label="@ButtonName">
            @if (Icon)
            {
                <Icon Name="IconName.More" />
            }
            else
            {
                @Label
                <Icon Name="IconName.Chevron" Size="ChevronSize" />
            }
        </BitBhMenuButton>
        <BitBhMenuItems class="menu" Anchor="@("bottom start")" Portal="false">
            @foreach (MenuItem item in Ordered)
            {
                <BitBhMenuItem class="menu-item" data-destructive="@item.Destructive" Disabled="item.Disabled" OnClick="() => SelectAsync(item)">
                    <span>@item.Label</span>
                    @if (item.Shortcut.Length > 0)
                    {
                        <kbd class="menu-shortcut">@item.Shortcut</kbd>
                    }
                </BitBhMenuItem>
            }
        </BitBhMenuItems>
    </BitBhMenu>
</div>
