<div class="al-toast-root">
    <BitBhToastViewport Id="@HostId" popover="manual" Context="toast" class="al-toasts">
        <BitBhToast Item="toast" data-variant="@toast.Variant" class="al-toast">
            <BitBhToastTitle class="al-toast-title">@toast.Title</BitBhToastTitle>
            @if (toast.Options.ActionLabel is not null)
            {
                <BitBhToastAction class="al-toast-action" />
            }
            <BitBhToastClose aria-label="Dismiss notification" class="al-toast-close">×</BitBhToastClose>
        </BitBhToast>
    </BitBhToastViewport>
</div>
