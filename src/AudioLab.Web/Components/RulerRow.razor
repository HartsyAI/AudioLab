<div class="row" data-kind="@Kind.ToString().ToLowerInvariant()" style="width: @Css.Px(Width)" @onclick="SeekAsync">
    @switch (Kind)
    {
        case RulerRowKind.Sections:
            @foreach (Section section in Document.Sections)
            {
                <div @key="section.Id" class="section" style="@SectionStyle(section)">@section.Name</div>
            }
            break;
        case RulerRowKind.Bars:
            @foreach (BarLine bar in Bars)
            {
                <span class="tick" data-strong="@(bar.Strong ? "true" : "false")" style="left: @Css.Px(Left(bar.Time))">@bar.Number</span>
            }
            <LoopRange Part="LoopRangePart.Ruler" Geometry="Geometry" />
            <Playhead Part="PlayheadPart.Cap" Geometry="Geometry" />
            break;
        case RulerRowKind.Time:
            @foreach (double time in Times)
            {
                <span class="tick" data-strong="false" style="left: @Css.Px(Left(time))">@TimeText.Ruler(time)</span>
            }
            break;
        case RulerRowKind.Markers:
            @foreach (Marker marker in Document.Markers)
            {
                <span @key="marker.Id" class="marker" style="@MarkerStyle(marker)">@marker.Name</span>
            }
            break;
    }
</div>
