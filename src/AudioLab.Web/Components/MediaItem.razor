@if (File is not null)
{
    <li class="media-item" data-kind="file" data-selected="@(Selected ? "true" : "false")">
        <button type="button" id="@ElementId" class="media-main" role="button" tabindex="@(TabStop ? 0 : -1)"
                aria-pressed="@(Selected ? "true" : "false")"
                aria-label="@Description" title="@Hint" @onclick="SelectAsync" @onkeydown="KeyAsync" @onpointerdown="PressAsync">
            <span class="media-name">@File.Name</span>
            <span class="media-length">@MediaText.Length(File.Duration)</span>
            <span class="media-format">@MediaText.Format(File)</span>
            <span class="media-size">@MediaText.Size(File.Bytes)</span>
        </button>
        <Button Variant="ButtonVariant.Icon" Name="@($"Add {File.Name} to the arrangement")" Shortcut="@Shortcuts.AddMedia.Display" tabindex="-1"
                OnClick="AddAsync">
            <Icon Name="IconName.Plus" />
        </Button>
        <Button Variant="ButtonVariant.Icon" Name="@($"Delete {File.Name}")" Shortcut="@Shortcuts.DeleteMedia.Display" tabindex="-1"
                OnClick="DeleteAsync">
            <Icon Name="IconName.Trash" />
        </Button>
    </li>
}
else if (Job is not null)
{
    <li class="media-item" data-kind="upload" data-state="@StateName">
        <span class="media-name" title="@Job.Name">@Job.Name</span>
        @if (Job.State == UploadState.Failed)
        {
            <span class="media-failure">@Job.Failure</span>
            <Button OnClick="RetryAsync">Try again</Button>
            <Button Variant="ButtonVariant.Icon" Name="@($"Dismiss {Job.Name}")" OnClick="CancelAsync">
                <Icon Name="IconName.Close" Size="10" />
            </Button>
        }
        else
        {
            <Progress Label="@($"Uploading {Job.Name}")" Fraction="ProgressFraction" Text="@ProgressText" OnCancel="CancelAsync"
                      CancelLabel="@($"Cancel uploading {Job.Name}")" />
        }
    </li>
}
