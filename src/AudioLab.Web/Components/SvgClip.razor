<div class="@CssClass" style="@InlineStyle">
    <div class="head">@Clip.Name</div>
    <div class="body">
        @if (Clip.IsMidi)
        {
            @foreach (NoteSpan note in Clip.Notes)
            {
                <div class="note" style="left: @(note.X)%; top: @(note.Y)%; width: @(note.Width)%"></div>
            }
        }
        else
        {
            <svg viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true"><path d="@Paths.For(Clip)"></path></svg>
        }
    </div>
</div>
