<div class="header" role="listitem" data-selected="@(Selected ? "true" : "false")" style="height: @Css.Px(Height)" @onclick="SelectAsync">
    <div class="strip" style="background: @ColorToken"></div>
    <div class="number">@Number</div>
    <div class="main">
        <div class="row">
            <button type="button" class="name" aria-pressed="@(Selected ? "true" : "false")" title="@NameHint" @onclick="SelectAsync"
                    @onclick:stopPropagation="true" @ondblclick="RenameAsync">@Track.Name</button>
            <div class="toggles">
                <Toggle Track="true" Label="M" Name="@($"Mute {Track.Name}")" Tone="ToggleTone.Mute" On="Track.Muted"
                        Disabled="!Editable" Reason="@(Editable ? null : Reason)" OnClick="MuteAsync" />
                <Toggle Track="true" Label="S" Name="@($"Solo {Track.Name}")" Tone="ToggleTone.Caution" On="Track.Soloed"
                        Disabled="!Editable" Reason="@(Editable ? null : Reason)" OnClick="SoloAsync" />
                <Toggle Track="true" Label="R" Name="@($"Record arm {Track.Name}")" Tone="ToggleTone.Record" On="Track.Armed"
                        Disabled="true" Reason="@RecordingReason" />
                <Toggle Track="true" Label="I" Name="@($"Input monitor {Track.Name}")" Tone="ToggleTone.Go" On="Track.Monitor"
                        Disabled="true" Reason="@RecordingReason" />
            </div>
        </div>
        <div class="row">
            <span class="source">@Source</span>
            <Slider Label="@($"Volume of {Track.Name}")" Position="VolumePosition" Text="@VolumeText" />
        </div>
    </div>
    <div class="meter">
        <Meter />
    </div>
</div>
