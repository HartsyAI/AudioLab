<div class="header" data-selected="@(Selected ? "true" : "false")" style="height: @(Height)px" @onclick="SelectAsync">
    <div class="strip" style="background: @ColorToken"></div>
    <div class="number">@Number</div>
    <div class="main">
        <div class="row">
            <span class="name">@Track.Name</span>
            <div class="toggles">
                <Toggle Track="true" Label="M" Name="@($"Mute {Track.Name}")" Tone="ToggleTone.Mute" On="Track.Muted" />
                <Toggle Track="true" Label="S" Name="@($"Solo {Track.Name}")" Tone="ToggleTone.Caution" On="Track.Soloed" />
                <Toggle Track="true" Label="R" Name="@($"Record arm {Track.Name}")" Tone="ToggleTone.Record" On="Track.Armed" />
                <Toggle Track="true" Label="I" Name="@($"Input monitor {Track.Name}")" Tone="ToggleTone.Go" On="Track.Monitor" />
            </div>
        </div>
        <div class="row">
            <span class="source">@Source</span>
            <Slider Label="@($"Volume of {Track.Name}")" Position="VolumePosition" Text="@VolumeText" />
        </div>
    </div>
    <div class="meter">
        <Meter />
    </div>
</div>
