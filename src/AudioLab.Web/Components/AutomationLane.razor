<div class="automation" role="group" aria-label="@Name" tabindex="0" data-editable="@(Editable ? "true" : "false")"
     style="top: @Css.Px(Top); width: @Css.Px(Width); height: @Css.Px(Plan.Height)" title="@(Editable ? null : Reason)"
     @onkeydown="KeyAsync" @onkeydown:stopPropagation="true" @ondblclick="DoubleClickAsync">
    <svg class="line" width="@Css.Number(Width)" height="@Css.Number(Plan.Height)" aria-hidden="true">
        <path d="@Path" style="stroke: @ColorToken"></path>
    </svg>
    @for (int index = 0; index < Shown.Count; index++)
    {
        AutomationPoint point = Shown[index];
        <div class="point" data-selected="@(index == SelectedIndex ? "true" : "false")"
             style="left: @Css.Px(Plan.X(point.Time) - PointRadius); top: @Css.Px(Plan.Y(point.Value) - PointRadius)"
             @onpointerdown="press => PointDownAsync(index, press)" @onpointerdown:stopPropagation="true"
             @ondblclick:stopPropagation="true"></div>
    }
</div>
