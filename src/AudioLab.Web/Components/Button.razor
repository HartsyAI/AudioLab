<span class="button-root">
    @if (Href is not null)
    {
        <a class="button" href="@Href" data-variant="@VariantName" @attributes="Attributes">@ChildContent</a>
    }
    else if (Name is null)
    {
        <button type="@ButtonType" class="button" data-variant="@VariantName" disabled="@Disabled" @onclick="ClickAsync"
                @attributes="Attributes">@ChildContent</button>
    }
    else
    {
        <BitBhTooltip>
            <BitBhTooltipTrigger As="button" type="@ButtonType" class="button" data-variant="@VariantName" aria-label="@Name"
                                 aria-disabled="@AriaDisabled" @onclick="ClickAsync" @attributes="Attributes">@ChildContent</BitBhTooltipTrigger>
            <BitBhTooltipContent class="tooltip" Anchor="@(new BitBhAnchorOptions { To = "bottom", Gap = 6 })">
                <span class="tooltip-name">@TooltipText</span>
                @if (Shortcut is not null && !Disabled)
                {
                    <kbd class="tooltip-shortcut">@Shortcut</kbd>
                }
            </BitBhTooltipContent>
        </BitBhTooltip>
    }
</span>
