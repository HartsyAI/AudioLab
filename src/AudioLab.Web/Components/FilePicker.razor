@foreach (Chooser chooser in _choosers)
{
    bool current = chooser == _choosers[^1];
    <InputFile @key="chooser.Number" id="@IdOf(chooser)" class="@(current ? Class : null)" multiple accept=".wav,audio/wav,audio/x-wav"
               OnChange="args => ChosenAsync(args, chooser)" aria-label="@Label" tabindex="@TabIndex" hidden="@(current ? null : "hidden")" />
}
