<header class="bar">
    <div class="brand">
        <div class="logo">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="stroke: var(--ink)" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M2.5 7v2M5.5 4.5v7M8.5 2.5v11M11.5 5v6M14 7v2"></path></svg>
        </div>
        <div class="title">
            <span class="name">Midnight Drive</span>
            <span class="saved">Saved 12 s ago</span>
        </div>
    </div>

    <Segmented>
        <Button Kind="ButtonKind.Glyph" Width="34" Height="28" AriaLabel="Go to start"><svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><rect x="2" y="2.5" width="1.8" height="9" rx="0.6"></rect><polygon points="12,2.5 12,11.5 5,7"></polygon></svg></Button>
        <Button Kind="ButtonKind.Glyph" Width="34" Height="28" AriaLabel="Stop"><svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.2"></rect></svg></Button>
        <Button Kind="ButtonKind.Go" Width="40" Height="28" AriaLabel="Play"><svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><polygon points="4,2.2 12,7 4,11.8"></polygon></svg></Button>
        <Button Kind="ButtonKind.Glyph" Width="34" Height="28" AriaLabel="Record"><svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" style="color: var(--record)" aria-hidden="true"><circle cx="7" cy="7" r="4.2"></circle></svg></Button>
    </Segmented>

    <Counter>
        <CounterCell Caption="TIME" Value="0:00:18.500" Large="true" />
        <CounterCell Caption="BARS" Value="10.2.1" Large="true" />
        <CounterCell Caption="TEMPO" Value="120.00" />
        <CounterCell Caption="METER" Value="4/4" />
        <CounterCell Caption="KEY" Value="A min" />
    </Counter>

    <div class="toggles">
        <Button Kind="ButtonKind.Primary">Loop</Button>
        <Button>Click</Button>
        <Button>Punch</Button>
        <Button>Follow</Button>
    </div>

    <div class="spacer"></div>

    <Segmented>
        <Button Kind="ButtonKind.Chosen" Width="30" Height="24" AriaLabel="Pointer tool"><svg width="13" height="13" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><polygon points="3,1.5 11.5,8 7.6,8.4 9.6,12.4 8,13.1 6.1,9.1 3,11.6"></polygon></svg></Button>
        <Button Kind="ButtonKind.Bare" Width="30" Height="24" AriaLabel="Range tool"><svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4.5 2h5M7 2v10M4.5 12h5"></path></svg></Button>
    </Segmented>
    <Button Kind="ButtonKind.Select"><span class="dim">Grid</span><span>1/16</span><svg width="9" height="9" viewBox="0 0 10 10" fill="none" style="stroke: var(--text-faint)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.5l3 3 3-3"></path></svg></Button>

    <div class="presence">
        <div class="avatar you">You</div>
        <div class="avatar agent">AI</div>
    </div>
    <Button Kind="ButtonKind.Primary" Size="ButtonSize.Medium"><span class="export">Export</span></Button>
</header>
