<div class="strip" data-master="@(Master ? "true" : "false")" data-selected="@(Selected ? "true" : "false")" role="group"
     aria-label="@($"Channel {Name}")" style="width: @(Width)rem">
    <div class="head">
        <span class="dot" style="background: @ColorToken"></span>
        <span class="name">@Name</span>
    </div>
    <div class="slots">
        @foreach ((string? name, bool enabled) in Slots)
        {
            <EffectSlot Name="@name" Enabled="enabled" />
        }
    </div>
    <Knob Label="@($"Pan of {Name}")" Position="Pan" Text="@PanText" />
    <div class="fader-row">
        <Fader Label="@($"Volume of {Name}")" Position="VolumePosition" Text="@VolumeText" />
        <div class="meter"><Meter /></div>
    </div>
    <div class="foot">
        @if (!Master)
        {
            <Toggle Track="true" Label="M" Name="@($"Mute {Name}")" Tone="ToggleTone.Mute" On="Muted" />
            <Toggle Track="true" Label="S" Name="@($"Solo {Name}")" Tone="ToggleTone.Caution" On="Soloed" />
        }
        <span class="db">@VolumeText</span>
    </div>
</div>
