<div class="overlay" aria-hidden="true" style="width: @Css.Px(Geometry.Width); height: @Css.Px(Geometry.Height); --clip: @ColorToken">
    <div class="insert" style="left: @Css.Px(Geometry.X(State.InsertTime))"></div>
    @if (Drag is { Active: true } drag)
    {
        <svg class="ghosts" viewBox="0 0 @Css.Number(Geometry.Length) @RollGeometry.Pitches" preserveAspectRatio="none"
             width="@Css.Number(Geometry.Width)"
             height="@Css.Number(Geometry.Height)" style="@Carried(drag)">
            <path class="ghost" d="@Ghosts(drag)"></path>
            <path class="erased" d="@Erased(drag)"></path>
        </svg>
        @if (drag.Marquee is { } box)
        {
            <div class="marquee" style="left: @Css.Px(box.X); top: @Css.Px(box.Y); width: @Css.Px(box.Width); height: @Css.Px(box.Height)"></div>
        }
    }
</div>
