<svg class="grid" viewBox="0 0 @Css.Number(Geometry.Length) @RollGeometry.Pitches" preserveAspectRatio="none" width="@Css.Number(Geometry.Width)"
     height="@Css.Number(Geometry.Height)" aria-hidden="true">
    <path class="rows" d="@BlackRows"></path>
    <path class="octaves" d="@Octaves"></path>
    <path class="steps" d="@Lines.Steps"></path>
    <path class="beats" d="@Lines.Beats"></path>
    <path class="bars" d="@Lines.Bars"></path>
</svg>
