@inherits LayoutComponentBase

<div class="shell" @ondragenter="DragEnter" @ondragover:preventDefault="@(!_dropping)" @ondrop:preventDefault="@(!_dropping)"
     @onkeydown="CloseOnKey" @onpointerdown="CloseOnPress">
    <ErrorBoundary @ref="_boundary">
        <ChildContent>@Body</ChildContent>
        <ErrorContent>
            <EmptyState Heading="Something went wrong" Message="This screen stopped working. Try again, or go back to your projects.">
                <Button Variant="ButtonVariant.Primary" OnClick="Recover">Try again</Button>
                <Button Href="">Go to your projects</Button>
            </EmptyState>
        </ErrorContent>
    </ErrorBoundary>
    <MediaDropOverlay @bind-Active="_dropping" />
    <ToastHost />
</div>
