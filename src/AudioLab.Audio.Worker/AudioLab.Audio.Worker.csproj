<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- Hosts the engine in a web worker: a second .NET runtime that the worker script starts and calls through the exports compiled in below. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AudioLab.Web.Interop.Worker</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmFingerprintDotnetJs>false</WasmFingerprintDotnetJs>
    <StaticWebAssetBasePath>worker</StaticWebAssetBasePath>
    <!-- A build with the debugger component interprets several times slower, and the engine renders audio on time or not at all. -->
    <WasmDebugLevel>0</WasmDebugLevel>
  </PropertyGroup>

  <!-- Ahead-of-time compilation of the engine, for a publish: `-p:AudioLabWorkerAot=true`, which needs the wasm-tools workload (docs/engine-aot.md).
       It is a property of its own and not RunAOTCompilation, which would compile the page's runtime as well. -->
  <PropertyGroup Condition="'$(AudioLabWorkerAot)' == 'true'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup Condition="'$(AudioLabWorkerAot)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AudioLabAot</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioLab.Audio\AudioLab.Audio.csproj" />
  </ItemGroup>

  <!-- The exports live where all interop lives (AGENTS.md); only this runtime compiles them. -->
  <ItemGroup>
    <Compile Include="..\AudioLab.Web\Interop\Worker\*.cs" LinkBase="Interop\Worker" />
  </ItemGroup>

</Project>
